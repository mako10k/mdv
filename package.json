{
  "name": "mdv",
  "private": true,
  "version": "0.1.2",
  "description": "Minimal Windows markdown editor with WYSIWYG, source, diff and patch support.",
  "author": "GitHub Copilot",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node ./scripts/mdast-submodule.mjs postinstall",
    "mdast:install": "node ./scripts/mdast-submodule.mjs install",
    "mdast:build": "node ./scripts/mdast-submodule.mjs build",
    "mdast:check": "node ./scripts/mdast-submodule.mjs check",
    "mdast:watch": "node ./scripts/mdast-submodule.mjs watch",
    "dev:web": "vite",
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "dev:with-mdast": "concurrently -k \"npm run mdast:watch\" \"vite\" \"wait-on tcp:5173 && electron .\"",
    "server:start": "node ./server/mdv-server.cjs",
    "build:icons": "node ./scripts/build-icons.mjs",
    "typecheck:electron-openai": "tsc -p tsconfig.electron-openai.json --noEmit",
    "build": "npm run mdast:build && tsc -b && npm run typecheck:electron-openai && vite build",
    "start": "electron .",
    "dist:win:host": "npm run dist:win:host:full",
    "dist:win:host:full": "bash ./scripts/build-win-host.sh -Mode full",
    "dist:win:host:diff": "bash ./scripts/build-win-host.sh -Mode diff",
    "dist:win:host:unpacked": "npm run dist:win:host:unpacked:full",
    "dist:win:host:unpacked:full": "bash ./scripts/build-win-host.sh -Mode full -PackageTargets none",
    "dist:win:host:unpacked:diff": "bash ./scripts/build-win-host.sh -Mode diff -PackageTargets none",
    "dist:win:host:noadmin": "npm run dist:win:host:noadmin:full",
    "dist:win:host:noadmin:full": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$(wslpath -w ./scripts/build-win-host.ps1)\" -Mode full",
    "dist:win:host:noadmin:diff": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$(wslpath -w ./scripts/build-win-host.ps1)\" -Mode diff",
    "dist:win:host:noadmin:unpacked": "npm run dist:win:host:noadmin:unpacked:full",
    "dist:win:host:noadmin:unpacked:full": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$(wslpath -w ./scripts/build-win-host.ps1)\" -Mode full -PackageTargets none",
    "dist:win:host:noadmin:unpacked:diff": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$(wslpath -w ./scripts/build-win-host.ps1)\" -Mode diff -PackageTargets none",
    "dist:win:dir": "npm run build && electron-builder --win dir",
    "dist:win:portable": "npm run build && electron-builder --win portable --config.directories.output=release/portable",
    "dist:win:installer": "npm run build && electron-builder --win nsis --config.directories.output=release/installer",
    "dist:win": "npm run build && electron-builder --win portable --config.directories.output=release/portable && electron-builder --win nsis --config.directories.output=release/installer",
    "lint": "eslint .",
    "preview": "vite preview",
    "release:check": "node ./scripts/check-release-candidate.mjs",
    "release:github": "node ./scripts/prepare-github-release.mjs",
    "test": "npm run test:e2e:install && npm run test:e2e",
    "test:release": "node --test tests/release/*.spec.mjs",
    "test:e2e": "tsc -p tsconfig.playwright.json --noEmit && npm run build && playwright test",
    "test:e2e:electron": "tsc -p tsconfig.playwright.json --noEmit && npm run build && playwright test -c playwright.electron.config.ts",
    "test:e2e:headed": "tsc -p tsconfig.playwright.json --noEmit && npm run build && playwright test --headed",
    "test:e2e:install": "playwright install chromium"
  },
  "build": {
    "appId": "local.markdownviewer",
    "productName": "MarkDownViewer",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "artifactName": "MarkDownViewer-${version}-${os}.${ext}",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "vendor/mdast-control/dist/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "executableName": "MarkDownViewer"
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@toast-ui/editor": "^3.2.2",
    "commander": "^14.0.0",
    "diff": "^8.0.2",
    "katex": "^0.17.0",
    "markdown-it": "^14.1.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^11.12.1",
    "monaco-editor": "^0.55.1",
    "openai": "^6.39.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "png-to-ico": "^3.0.1",
    "@playwright/test": "^1.54.2",
    "rcedit": "^5.0.2",
    "sharp": "^0.34.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wait-on": "^9.0.3"
  }
}